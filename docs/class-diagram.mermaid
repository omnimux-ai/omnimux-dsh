classDiagram
    direction TB

    class ModelContract {
        +string id
        +string label
        +string family
        +string badge
        +OperationSpec[] operations
        +Map~string, ParameterSpec~ parameters
        +ImplementationSpec implementation
        +ExecutionSpec execution
        +getOperation(opId: string) OperationSpec
        +getParameter(paramId: string) ParameterSpec
    }

    class OperationSpec {
        +string id
        +string label
        +InputSlot[] inputs
        +OutputType output
        +string seam
        +string profileId
        +string status
        +isLive() bool
    }

    class ParameterSpec {
        +string id
        +string label
        +string type
        +string defaultValue
        +ParameterOption[] options
        +number min
        +number max
        +validate(value: any) bool
    }

    class AdapterProfile {
        +string id
        +string seam
        +string status
        +string[] operations
        +string[] logicalFields
        +string[] vendorFields
        +string[] forbiddenVendorFields
        +Map~string, ShapeConstraint~ operationVendorShapes
        +validatePayload(vendor: object, opId: string) ValidationResult
    }

    class AspectRatioConvergenceOperator {
        +mapOpenAiImageSize(aspectRatio: string, resolution: string) OpenAiSizeResult
        +mapGrokAspectRatio(aspectRatio: string) string
        +mapMidjourneyParams(prompt: string, aspectRatio: string, version: string) MidjourneyParamResult
        +mapVideoSizeOrRatio(family: string, modelId: string, aspectRatio: string) VideoDimensionResult
    }

    class ImageEditsRouter {
        +determineEndpoint(operation: string, references: ImageRef[]) string
        +buildEditsPayload(modelId: string, prompt: string, images: ImageRef[], extras: object) VendorPayload
    }

    class VideoVendorMapper {
        +mapSeedancePayload(modelId: string, operation: string, inputs: object, extras: object) VendorPayload
        +mapWanPayload(operation: string, inputs: object, extras: object) VendorPayload
        +mapMinimaxPayload(modelId: string, operation: string, inputs: object, extras: object) VendorPayload
        +mapKlingPayload(modelId: string, operation: string, inputs: object, extras: object) VendorPayload
        +mapGrokVideoPayload(operation: string, inputs: object, extras: object) VendorPayload
    }

    class AudioVendorMapper {
        +mapDoubaoAsrPayload(audioUrl: string, extras: object) VendorPayload
        +mapSeedAudioPayload(prompt: string, voice: string, extras: object) VendorPayload
        +mapSunoTaskPayload(prompt: string, extras: object) VendorPayload
    }

    class SubmitGuard {
        +admit(modelId: string, operationId: string) AdmissionResult
        +mapValidatedPlanToVendor(args: PlanArgs) VendorPayloadResult
        +assertVendorBodyAllowed(vendor: object, profile: AdapterProfile, opId: string) ValidationResult
    }

    ModelContract "1" *-- "many" OperationSpec : defines
    ModelContract "1" *-- "many" ParameterSpec : defines
    OperationSpec ..> AdapterProfile : references profileId
    SubmitGuard ..> ModelContract : validates against
    SubmitGuard ..> AdapterProfile : enforces
    SubmitGuard ..> AspectRatioConvergenceOperator : delegates dimension normalization
    SubmitGuard ..> ImageEditsRouter : delegates image edits
    SubmitGuard ..> VideoVendorMapper : delegates video vendor mapping
    SubmitGuard ..> AudioVendorMapper : delegates audio vendor mapping
