r_url":"","media_url":"","media_type":"other","tags":["opc-skills-short-drama-…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/opc-skills-short-drama-router/references/ingest.md","ext":".md","pack":"opc-skills-short-drama-router","bytes":null}},{"id":"knowledge-storyboard-69e00b378975","category":"knowledge","sub_category":"storyboard","name":"钩子设计手册","description":"观众看完一集，手指悬在屏幕上——划走还是继续？这个决定在最后10秒做出。钩子的作用就是让那根手指\"划不动\"。","cover_url":"","media_url":"","media_type":"other","tags":["short-drama","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/short-drama/references/hook-design.md","ext":".md","pack":"short-drama","bytes":null}},{"id":"knowledge-storyboard-6a617f34dfcb","category":"knowledge","sub_category":"storyboard","name":"剧集圣经 Schema（series bible）","description":"> series bible 是整部剧的「总账本」，跨集追踪角色、剧情、悬念。是多集一致性的源头。 > `drama_ops.py scaffold` 会生成模板，据题材填满。","cover_url":"","media_url":"","media_type":"other","tags":["Easel-short-drama","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/Easel-short-drama/references/series-bible-schema.md","ext":".md","pack":"Easel-short-drama","bytes":null}},{"id":"knowledge-storyboard-6b44cdba45ff","category":"knowledge","sub_category":"storyboard","name":"开发阶段契约","description":"本文件是本技能的自包含契约：预检、所有权、形态输入与规则表都在这里， 不需要读取其他技能的文件。","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-develop/references/stage-contract.md","ext":".md","pack":"drama-skills-short-drama-develop","bytes":null}},{"id":"knowledge-storyboard-6cb88a9b862a","category":"knowledge","sub_category":"storyboard","name":"Look、View 与道具状态变体提示词","description":"1. 什么时候需要变体 2. Base—delta—validity 3. 三类变体的写法 4. 变体 plate 与 edit 的区别 5. 输出、失败与审查","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-image-prompts/references/look-and-state-variant.md","ext":".md","pack":"drama-skills-short-drama-image-prompts","bytes":null}},{"id":"knowledge-storyboard-6e80147a086d","category":"knowledge","sub_category":"storyboard","name":"生产剧本格式与写作工艺","description":"来自对不同短剧格式怎样流入资产与分镜的定性案例阅读，示例均为合成改写。本套件的 规范格式见 [screenplay-format.md](screenplay-format.md)；本文档服务三个场景：","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-write/references/production-format-dialect.md","ext":".md","pack":"drama-skills-short-drama-write","bytes":null}},{"id":"knowledge-storyboard-70fc758e065b","category":"knowledge","sub_category":"storyboard","name":"改编价值与分集候选","description":"前面几步产出的是「这本书是怎么运转的」。这一步回答的是**「这本书里有多少东西能在竖屏 短剧里成立」**——这是拆书和改编分析的分水岭，也是本技能存在的理由。","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-novel-analyze/references/adaptation-value.md","ext":".md","pack":"drama-skills-short-drama-novel-analyze","bytes":null}},{"id":"knowledge-storyboard-740061d94c39","category":"knowledge","sub_category":"storyboard","name":"歌词格式示例","description":"以下是角色主题曲/OP/ED 歌词的标准格式。歌词使用段落标记 `[section]`，与 Music API 的歌词输入格式兼容。","cover_url":"","media_url":"","media_type":"other","tags":["OmniMux-skills-drama-so…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/OmniMux-skills-drama-soundtrack/references/lyrics-example.md","ext":".md","pack":"OmniMux-skills-drama-soundtrack","bytes":null}},{"id":"knowledge-storyboard-756f0b5fc5e9","category":"knowledge","sub_category":"storyboard","name":"聚合与实体","description":"聚合只读 S2 的逐章提取，**不回头重读原文**。原文在 S2 已经被读过一次；再读一次得到的 不是补充，是第二份互相矛盾的事实。需要核对某条硬事实时回查具体那一条白描， 而不是重新通读。","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-novel-analyze/references/aggregation-and-entities.md","ext":".md","pack":"drama-skills-short-drama-novel-analyze","bytes":null}},{"id":"knowledge-storyboard-761c51ffc99b","category":"knowledge","sub_category":"storyboard","name":"项目定位与安全写入","description":"优先使用用户给出的项目路径；没有项目时可以直接在用户指定目录完成独立任务。需要项目配置时运行：","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-drama","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama/references/runtime-preflight.md","ext":".md","pack":"drama-skills-short-drama","bytes":null}},{"id":"knowledge-storyboard-76deb8391668","category":"knowledge","sub_category":"storyboard","name":"爽感矩阵","description":"**定义**：通过暴露隐藏的高阶身份，实现对嘲讽者/欺压者的降维打击。","cover_url":"","media_url":"","media_type":"other","tags":["OmniMux-skills-short-dr…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/OmniMux-skills-short-drama-screenwriter/references/satisfaction-matrix.md","ext":".md","pack":"OmniMux-skills-short-drama-screenwriter","bytes":null}},{"id":"knowledge-storyboard-7845afd57cab","category":"knowledge","sub_category":"storyboard","name":"节奏曲线设计","description":"微短剧的节奏不是\"一直爽\"，而是\"紧→松→更紧→松→最紧\"的波形。就像过山车，持续加速反而麻木，有起有落才刺激。","cover_url":"","media_url":"","media_type":"other","tags":["short-drama","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/short-drama/references/rhythm-curve.md","ext":".md","pack":"short-drama","bytes":null}},{"id":"knowledge-storyboard-791078194c67","category":"knowledge","sub_category":"storyboard","name":"身份、版本与复用判断","description":"不要先问“要不要新建文件”，按顺序问：","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-assets/references/identity-vs-variant.md","ext":".md","pack":"drama-skills-short-drama-assets","bytes":null}},{"id":"knowledge-storyboard-7ada253eb176","category":"knowledge","sub_category":"storyboard","name":"交付档案：容器算术与槽位语义","description":"交付档案是创作者**可选**声明的一份排布约定：把已接受的运动规格摊成执行端逐行读取的 文本。本套件只规定每个槽位**必须回答什么**（语义），不规定它**写成什么样子**（语法）。","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-video-prompts/references/delivery-profile.md","ext":".md","pack":"drama-skills-short-drama-video-prompts","bytes":null}},{"id":"knowledge-storyboard-7f7628d08f88","category":"knowledge","sub_category":"storyboard","name":"创作参考作品的安全摄取","description":"用户提供对标剧、小说、分镜样例或提示词时，学习它解决问题的机制，不召回它的表达外壳。 本流程只读取用户在当前会话明确提供或授权的材料；不自行连接外部、非公开项目库。","cover_url":"","media_url":"","media_type":"other","tags":["drama-skills-short-dram…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/drama-skills-short-drama-develop/references/creative-reference-intake.md","ext":".md","pack":"drama-skills-short-drama-develop","bytes":null}},{"id":"knowledge-storyboard-844145d2ddcd","category":"knowledge","sub_category":"storyboard","name":"付费点设计指南","description":"付费点必须设在观众情绪最高涨的时刻，而非平淡叙事中。","cover_url":"","media_url":"","media_type":"other","tags":["OmniMux-skills-short-dr…","短剧拆镜"],"meta":{"source":"local-file","source_path":"skills/OmniMux-skills-short-drama-screenwriter/references/paywall-design.md","ext":".md","pack":"OmniMux-skills-short-drama-screenwriter","bytes":null}}]}
