{
  "name": "omnimux-intercept",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "intercept": "./src/cli.js"
  },
  "files": [
    "src",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
