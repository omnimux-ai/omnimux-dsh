{
  "name": "omnimux-avatar",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "lib/capability-core.js",
    "data",
    "cordis.patch.yml",
    "dsh.manifest.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "test": "node --test src/*.test.mjs src/client/*.test.mjs src/client/*.test.js src/client/lib/*.test.mjs src/client/hooks/*.test.mjs src/client/components/*.test.mjs",
    "prepublishOnly": "node ../../scripts/verify-publish-source.mjs ."
  },
  "dependencies": {
    "dsh-ui-kit": "file:../../packages/dsh-ui-kit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "OmniMux 数字人管理：结构化角色设定、生成与多视角派生、任务管理，生成结果自动归档到资产库「角色」分类",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
