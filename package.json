{
  "name": "omnimux-dsh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "node scripts/omnimux.mjs dev",
    "sync": "node scripts/omnimux.mjs sync",
    "doctor": "node scripts/omnimux.mjs doctor",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:env": "bash scripts/dev-env.sh",
    "build:all": "node scripts/omnimux.mjs build:all",
    "lint:i18n": "node scripts/omnimux.mjs lint:i18n",
    "analyze:refactor": "node scripts/omnimux.mjs analyze:refactor",
    "lint:refactor": "node scripts/code-refactor-analyzer.mjs --check",
    "test:refactor": "node --test scripts/code-refactor-analyzer.test.mjs",
    "doc:lint": "node scripts/omnimux.mjs doc:lint",
    "doc:index": "node scripts/omnimux.mjs doc:index",
    "registry": "node scripts/omnimux.mjs registry",
    "registry:build": "node scripts/registry-tool.mjs build",
    "registry:verify": "node scripts/registry-tool.mjs verify",
    "stage": "node scripts/omnimux.mjs stage",
    "package:dev": "node scripts/omnimux.mjs package:dev",
    "omnimux": "node scripts/omnimux.mjs",
    "wt": "bash scripts/git-wt.sh",
    "wt:start": "bash scripts/git-wt.sh start",
    "wt:auto-start": "bash scripts/git-wt.sh auto-start",
    "wt:finish": "bash scripts/git-wt.sh finish",
    "wt:clean": "bash scripts/git-wt.sh clean",
    "wt:list": "bash scripts/git-wt.sh list",
    "wt:doctor": "bash scripts/git-wt.sh doctor",
    "qa:gate": "node scripts/auto-qa-gate.mjs",
    "qa:verdict": "node scripts/ci-verdict.mjs",
    "test:ci": "node --test scripts/auto-pipeline.test.mjs scripts/check-tracked-artifacts.test.mjs",
    "note:lint": "node scripts/verify-agent-note-format.mjs",
    "doc:pairing": "node scripts/verify-bilingual-docs.mjs",
    "doc:pairing:write": "node scripts/verify-bilingual-docs.mjs --write",
    "archived:verify": "node scripts/verify-archived-agent-notes.mjs",
    "archived:seal": "node scripts/verify-archived-agent-notes.mjs --write",
    "check:boundaries": "node scripts/verify-plugin-boundaries.mjs",
    "test:gates": "node --test scripts/verify-ci-gates.test.mjs scripts/ego-browser-qa.test.mjs scripts/live-qa.test.mjs scripts/codex-browser-qa.test.mjs scripts/live-runtime-proof.test.mjs",
    "auto:run": "node scripts/auto-pipeline.mjs",
    "test": "corepack pnpm --filter omnimux test && corepack pnpm --filter omnimux-accounts test && corepack pnpm --filter omnimux-inspiration test && corepack pnpm --filter omnimux-market test && corepack pnpm --filter omnimux-publish test && corepack pnpm test:gates",
    "test:all": "corepack pnpm -r test && corepack pnpm test:gates",
    "test:ui": "node scripts/scan-ui-gates.mjs",
    "test:e2e-mock": "OMNIMUX_MOCK_MODE=replay node scripts/mock-sidecar.test.mjs",
    "test:dx": "node scripts/test-dx-pipeline.mjs",
    "smoke": "bash scripts/smoke.sh",
    "accept:apps": "bash scripts/accept-apps-install.sh",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:model-contracts": "node scripts/verify-model-contracts.mjs --strict",
    "verify:tools": "node scripts/verify-plugin-agent-tools.mjs",
    "verify:image-live": "node scripts/verify-omnimux-image-live.mjs",
    "verify:stages": "node scripts/verify-stage-contracts.mjs",
    "verify:slots": "node scripts/verify-slot-contracts.mjs",
    "verify:smoke": "node scripts/verify-dev-smoke.mjs",
    "verify:live": "node scripts/agent-live-qa.mjs",
    "verify:gates": "corepack pnpm note:lint && corepack pnpm doc:pairing && corepack pnpm archived:verify && corepack pnpm check:boundaries && corepack pnpm check:package-files && corepack pnpm verify:tools && corepack pnpm verify:stages && corepack pnpm verify:slots && corepack pnpm test:gates",
    "verify:all": "corepack pnpm verify:gates && corepack pnpm test && corepack pnpm registry:verify && corepack pnpm doctor",
    "sync:presets": "bash scripts/sync-agent-presets.sh",
    "presets:build": "node scripts/build-agent-presets.mjs",
    "presets:verify": "node --test scripts/verify-agent-presets.test.mjs",
    "verify:cdp": "node scripts/verify-dev-cdp.mjs",
    "check:package-files": "node scripts/verify-package-files.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0"
  }
}
