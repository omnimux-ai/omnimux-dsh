{
  "PreToolUse": [
    {
      "matcher": "edit|write|bash",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/guard-worktree.mjs",
          "statusMessage": "🛡️ 检查工作区隔离规范与破坏性操作安全守卫",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/guard-ui-design.mjs",
          "statusMessage": "🎨 检查 UI 设计规范硬门禁（原生控件/内联样式/裸色/字阶）",
          "timeout": 5
        }
      ]
    }
  ]
}
